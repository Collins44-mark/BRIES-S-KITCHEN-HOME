{
  "name": "bries-home-kitchen",
  "version": "1.0.0",
  "private": true,
  "description": "BRIE'S HOME & KITCHEN — Retail Management System",
  "scripts": {
    "dev": "pnpm run --parallel dev:api dev:web",
    "dev:web": "pnpm --filter @bries/web dev",
    "dev:api": "pnpm --filter @bries/api start:dev",
    "build": "pnpm run db:generate && pnpm --filter @bries/types build && pnpm --filter @bries/api build && pnpm --filter @bries/web build",
    "lint": "pnpm --filter @bries/web lint && pnpm --filter @bries/api lint",
    "test": "pnpm --filter @bries/api test",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm --filter @bries/web typecheck && pnpm --filter @bries/api typecheck"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcrypt": "^5.1.1",
    "decimal.js": "^10.4.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
